# Python
__pycache__/
*.pyc
venv/
.venv/

# Environment — put ANTHROPIC_API_KEY in Replit Secrets
.env

# Node
frontend/node_modules/

# Vite build output — rebuilt on deploy by start.sh
frontend/dist/

# Database — transfer separately (too large for git)
# Use git-lfs or upload via Replit shell after creating the Repl.
data/*.db
data/*.db-shm
data/*.db-wal
data/sword_extracted/
data/stepbible/

# Stray DB files outside data/
backend/*.db
backend/*.db-shm
backend/*.db-wal
*.db-journal

# Stray shell config snippets
your

# Keep the data directory itself
!data/.gitkeep

# User-uploaded runtime media (not source)
data/media/
.claude/worktrees/
