run = "bash start.sh"
language = "python3"

[nix]
channel = "stable-24_05"

[unitTest]
language = "python3"

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8000
externalPort = 80

[deployment]
run = ["bash", "start.sh"]
deploymentTarget = "cloudrun"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash start.sh"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

# Set ANTHROPIC_API_KEY in Replit Secrets (Tools → Secrets), not here.
# DATA_PATH is intentionally unset — defaults to ./data relative to this file.
