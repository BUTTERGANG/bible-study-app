ANTHROPIC_API_KEY=your_key_here

# Optional shared-secret password. When set, all write endpoints + AI endpoints
# require Authorization: Bearer <APP_PASSWORD> or X-App-Password header.
# Leave unset for open dev mode.
# APP_PASSWORD=

# Comma-separated CORS origins for browser API calls. Defaults to the Vite dev
# server. Set to empty string when frontend is served same-origin.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI rate limits (per client IP). Defaults are generous for one user.
# AI_RATE_LIMIT_PER_MIN=15
# AI_RATE_LIMIT_PER_HOUR=120

# DATA_PATH defaults to ./data relative to the repo root — only set this
# if you need to point to a different location.
# DATA_PATH=./data

# LIBRARY_PATH is only needed when running ingest scripts locally.
# It should point to the folder containing SWORD zips, PDFs, and STEPBible TSVs.
# LIBRARY_PATH=/path/to/library
